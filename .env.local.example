# Copy this file to .env.local and fill in real values before building/deploying.
# Both are read at BUILD time (pages are statically generated), so set them
# in your hosting provider's env vars before the production build runs.

# Google Analytics 4 measurement ID from analytics.google.com
# (Admin > Data Streams > your stream > Measurement ID). Looks like "G-XXXXXXXXXX".
# Leave empty to disable analytics — no script is injected until this is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console verification code, from Search Console's
# "HTML tag" verification method — paste only the content="..." value, not
# the whole <meta> tag. Leave empty to omit the verification tag entirely.
GOOGLE_SITE_VERIFICATION=
